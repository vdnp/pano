{
  "name": "pano",
  "version": "0.1.0",
  "description": "Kişisel bildirim ve otomasyon paneli",
  "main": "./out/main/index.js",
  "author": "vdnp",
  "license": "MIT",
  "homepage": "https://github.com/vdnp/pano#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdnp/pano.git"
  },
  "bugs": {
    "url": "https://github.com/vdnp/pano/issues"
  },
  "scripts": {
    "dev": "npm run build:runtime && electron-vite dev",
    "build": "npm run build:runtime && electron-vite build",
    "start": "npm run build:runtime && electron-vite preview",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "build:runtime": "node scripts/build-plugin-runtime.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.0.0",
    "@fontsource/manrope": "^5.0.0",
    "croner": "10.0.1",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.8.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "20.14.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "io.github.vdnp.pano",
    "copyright": "Copyright © 2026 vdnp",
    "productName": "Pano",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*",
          "!ornek-kart/**"
        ]
      },
      {
        "from": "build",
        "to": "icons",
        "filter": [
          "tray*.png",
          "overlay-*.png"
        ]
      }
    ]
  }
}
